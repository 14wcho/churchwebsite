# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal data (each clone starts fresh)
/data/db.json
/local-videos/*
!/local-videos/.gitkeep

# tesseract language data — bundled at tessdata/ on purpose (see next.config.ts),
# but still ignore any stray copies downloaded elsewhere
*.traineddata
!/tessdata/eng.traineddata

.vercel
.env*
